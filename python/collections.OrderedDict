from collections import OrderedDict

n = int(input())
item_dict = OrderedDict()

for _ in range(n):
    # rsplit(' ', 1) splits only the last space, separating name from price
    item_name, price = input().rsplit(' ', 1)
    price = int(price)
    
    # If the item exists, add to its total; otherwise, create it
    item_dict[item_name] = item_dict.get(item_name, 0) + price

# Print the results in the order they were first added
for item, net_price in item_dict.items():
    print(f"{item} {net_price}")

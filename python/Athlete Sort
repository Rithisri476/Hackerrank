if __name__ == "__main__":
    # N = rows, M = attributes
    n, m = map(int, input().split())
    
    rows = []
    for _ in range(n):
        rows.append(list(map(int, input().split())))
    
    k = int(input())
    
    # Sort the list using the K-th element as the key
    # Python's sort is stable, maintaining input order for ties
    rows.sort(key=lambda x: x[k])
    
    # Print the sorted table
    for row in rows:
        print(*row)
